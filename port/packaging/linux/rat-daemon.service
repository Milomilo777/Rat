[Unit]
Description=Rat Daemon (Network Monitor)
After=network.target

[Service]
Type=simple
ExecStart=/usr/local/bin/rat-daemon
ExecStopPost=-/usr/sbin/nft delete table inet rat
Restart=on-failure
User=root
Group=rat
RuntimeDirectory=rat
RuntimeDirectoryMode=0750

[Install]
WantedBy=multi-user.target

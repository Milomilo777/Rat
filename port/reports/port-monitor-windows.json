    {
      "what": "Put WindowsMonitor inside #[cfg(windows)] block",
      "why": "To ensure it compiles correctly on Linux when running standard tests, as many Windows-specific traits and structs are only imported on Windows targets."
    },
    {
      "what": "Converted ports to `u16::from_be` inside `parse_port`",
      "why": "Ports stored in the MIB table structs are typically in network byte order (big-endian), so this ensures correct translation to native endian."
    },
